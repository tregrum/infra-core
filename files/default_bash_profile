# .bash_profile

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi

# Set up shell environment:
HOSTNAME=$(hostname -s)
alias xt='export TERM=xterm'

if [[ $- == *i* ]] ; then
    stty erase "^?"
    HISTFILE=~/.bash_history
    HISTSIZE=10240
    HISTTIMEFORMAT="%F %T "
    export HISTFILE HISTSIZE HISTTIMEFORMAT 
fi

